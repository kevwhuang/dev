---
import { Image } from 'astro:assets';

import { getFrames } from '@lib/images';

import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
}

const CLASS_LINK = 'project-card__link active:opacity-70 focus-visible:text-indigo-bright hover:text-indigo-bright inline relative self-start font-mono text-xs tracking-[0.08em] text-slate-light duration-(--duration-fast) transition-[color,opacity]';
const FRAME_WIDTH = 1_280;

const { project } = Astro.props;

const { data, id } = project;

const completedFormat = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC', year: 'numeric' });

const completedLabel = data.completed ? completedFormat.format(new Date(`${data.completed}-01T00:00:00Z`)) : '';
const frames = getFrames(id);
const placeholderLabel = data.completed ? data.name : 'In progress';

const hasPlaceholder = frames.length === 0;
---

<article
    class="project-card hover:border-slate flex flex-col h-full border border-graphite-light bg-night text-frost duration-(--duration-fast) transition-[border-color]"
    data-project={id}
>
    <div
        class="overflow-hidden relative aspect-[16/10] border-b border-graphite-light bg-night-light select-none"
        aria-hidden="true"
    >
        {hasPlaceholder && (
            <div class="absolute grid inset-4 overflow-hidden place-items-center border border-graphite-light">
                <span class="px-3 py-2 border border-slate font-mono text-xs tracking-[0.14em] uppercase bg-night-light text-frost">{placeholderLabel}</span>
            </div>
        )}
        {frames.map((image, index) => (
            <Image
                class="project-card__frame absolute inset-0 object-cover h-full w-full duration-(--duration-base) opacity-0 transition-opacity"
                alt=""
                data-current={index === 0 ? '' : undefined}
                data-frame
                densities={[1, 2]}
                src={image}
                width={FRAME_WIDTH}
            />
        ))}
    </div>
    <div class="flex flex-1 flex-col gap-6 p-8">
        <div class="flex flex-col gap-2">
            <h3 class="font-bold leading-[1.2] text-balance text-title tracking-[-0.04em] wrap-anywhere">{data.name}</h3>
            {data.domain && (
                <a
                    class={CLASS_LINK}
                    href={`https://${data.domain}`}
                    target="_blank"
                >
                    <span class="break-words">{data.domain}</span>
                    <span aria-hidden="true">&nbsp;&nearr;</span>
                    <span class="sr-only">(opens in new tab)</span>
                </a>
            )}
        </div>
        <p class="flex-1 max-w-(--measure-prose) text-base text-pretty wrap-anywhere text-silver">{data.description}</p>
        <ul class="flex flex-wrap gap-2">
            <li class="px-2 py-1 border border-graphite-light font-mono text-xs tracking-[0.14em] uppercase text-slate-light">
                {data.completed
                    ? <time datetime={data.completed}>{completedLabel}</time>
                    : 'Development'}
            </li>
            <li class="px-2 py-1 border border-graphite-light font-mono text-xs tracking-[0.14em] uppercase wrap-anywhere text-slate-light">{data.industry}</li>
        </ul>
    </div>
</article>

<style>
    .project-card__link::after {
        content: '';
        inset: -14px 0;
        position: absolute;
    }

    .project-card__frame[data-current] {
        opacity: 1;
    }
</style>

<script>
    import '@lib/frames';
</script>
