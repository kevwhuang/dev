---
import { getCollection } from 'astro:content';

import ProjectCard from '@components/ProjectCard.astro';
import { TIERS } from '@lib/constants';

const NUMBER_LENGTH = 2;

const projects = await getCollection('projects');

const tiers = TIERS.map((tier) => {
    const tierProjects = projects
        .filter(project => project.data.tier === tier.id)
        .sort((first, second) => first.data.name.localeCompare(second.data.name));
    const total = String(tierProjects.length).padStart(NUMBER_LENGTH, '0');

    return {
        ...tier,
        projects: tierProjects.map((project, index) => ({
            number: String(index + 1).padStart(NUMBER_LENGTH, '0'),
            project,
            total,
        })),
    };
});
---

{tiers.map((tier, index) => (
    <section
        class="tiers"
        aria-labelledby={`tiers-${tier.id}-title`}
    >
        <div class="shell">
            {index === 0 && <h1 class="sr-only">Work</h1>}
            <h2
                id={`tiers-${tier.id}-title`}
                class="mb-(--space-16) font-bold leading-[0.95] text-display tracking-[-0.04em]"
                data-scroll
            >
                {tier.label}
            </h2>
            <ul
                class="grid grid-cols-1 gap-(--space-24)"
                data-scroll
                data-scroll-stagger="0.08"
            >
                {tier.projects.map(entry => (
                    <li
                        id={entry.project.id}
                        class="tiers__stanza flex flex-col gap-4 min-w-0"
                    >
                        <div class="flex items-center gap-4 pt-4 border-t border-graphite-light">
                            <span class="font-mono text-xs tracking-[0.14em] uppercase text-indigo-bright">{entry.number}</span>
                            <span class="font-mono text-xs tracking-[0.14em] uppercase text-slate-light">{`/ ${entry.total}`}</span>
                        </div>
                        <ProjectCard project={entry.project} />
                    </li>
                ))}
            </ul>
        </div>
    </section>
))}

<style>
    .tiers {
        padding-block-start: var(--space-48);
    }

    .tiers__stanza {
        scroll-margin-top: var(--space-24);
    }
</style>
