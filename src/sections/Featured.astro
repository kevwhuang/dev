---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import { getFrames } from '@lib/images';

const CLASS_LINK = 'featured__link active:opacity-70 focus-visible:text-indigo-bright hover:text-indigo-bright relative self-start font-mono text-xs tracking-[0.08em] text-slate-light duration-(--duration-fast) transition-[color,opacity]';
const FRAME_WIDTH = 1_280;

const [featured] = await getCollection('projects', ({ data }) => data.featured);

const { data, id } = featured;

const { description, domain, industry, name } = data;

const frames = getFrames(id);

const pills = ['Development', industry];
---

<section
    class="featured section"
    aria-labelledby="featured-title"
>
    <div
        class="shell"
        data-scroll
    >
        <h2
            id="featured-title"
            class="sr-only"
        >
            Featured project
        </h2>
        <div class="featured__card flex flex-col border border-graphite-light text-frost">
            <div
                class="featured__preview overflow-hidden relative aspect-[16/10] min-w-0 border-b border-graphite-light bg-night-light select-none"
                aria-hidden="true"
                data-project={id}
            >
                {frames.map((image, index) => (
                    <Image
                        class="featured__frame absolute inset-0 object-cover h-full w-full duration-(--duration-base) opacity-0 transition-opacity"
                        alt=""
                        data-current={index === 0 ? '' : undefined}
                        data-frame
                        densities={[1, 2]}
                        src={image}
                        width={FRAME_WIDTH}
                    />
                ))}
                {frames.length === 0 && (
                    <div class="absolute grid inset-4 overflow-hidden place-items-center border border-graphite-light">
                        <span class="px-3 py-2 border border-slate font-mono text-xs tracking-[0.14em] uppercase bg-night-light text-frost">In progress</span>
                    </div>
                )}
            </div>
            <div class="flex flex-col justify-between min-w-0 gap-6 p-(--space-12)">
                <div class="flex flex-col gap-3">
                    <span class="font-mono text-xs tracking-[0.14em] uppercase text-indigo-bright">
                        <span class="inline-block size-1.5 mr-2 rounded-full align-middle bg-indigo" aria-hidden="true" />
                        Featured
                    </span>
                    <h3 class="font-bold leading-[1.1] text-balance text-heading tracking-[-0.04em] wrap-anywhere">{name}</h3>
                    <a
                        class={CLASS_LINK}
                        href={`https://${domain}`}
                        target="_blank"
                    >
                        <span class="break-words">{domain}</span>
                        <span aria-hidden="true">&nbsp;&nearr;</span>
                        <span class="sr-only">(opens in new tab)</span>
                    </a>
                    <p class="max-w-(--measure-prose) text-base text-pretty wrap-anywhere text-silver">{description}</p>
                </div>
                <ul class="flex flex-wrap gap-2">
                    {pills.map(pill => (
                        <li class="px-2 py-1 border border-graphite-light font-mono text-xs tracking-[0.14em] uppercase wrap-anywhere text-slate-light">{pill}</li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>

<style>
    .featured__link::after {
        content: '';
        inset: -14px 0;
        position: absolute;
    }

    .featured__frame[data-current] {
        opacity: 1;
    }
</style>

<script>
    import '@lib/frames';
</script>
