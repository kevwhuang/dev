---
import { CLASS_BUTTON, CLASS_ERROR_CODE } from '@lib/constants';
---

<section
    class="error-server section flex items-center min-h-[calc(100svh-var(--header-height))]"
    aria-labelledby="error-server-title"
>
    <div
        class="error-server__grid shell grid gap-x-8"
        data-scroll
    >
        <p
            class={CLASS_ERROR_CODE}
            aria-hidden="true"
        >
            500
        </p>
        <h1
            id="error-server-title"
            class="mb-(--gap-l) leading-[1.35] text-lead tracking-[-0.01em]"
        >
            <span class="sr-only">500: </span>
            Server error. Try again shortly.
        </h1>
        <a
            class={CLASS_BUTTON}
            href="/"
        >
            Return home
        </a>
    </div>
</section>

<style>
    .error-server__grid {
        grid-template-columns: 1fr 3fr;
    }

    .error-server__grid > * {
        grid-column-start: 2;
        justify-self: start;
    }

    @media (max-width: 768px) {
        .error-server__grid {
            grid-template-columns: 1fr;
        }

        .error-server__grid > * {
            grid-column-start: 1;
        }
    }
</style>
