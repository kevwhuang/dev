---
import { CLASS_BUTTON, CLASS_ERROR_CODE } from '@lib/constants';
---

<section
    class="error-not-found section flex items-center justify-center min-h-[calc(100svh-var(--header-height))] text-center"
    aria-labelledby="error-not-found-title"
>
    <div
        class="shell flex flex-col items-center"
        data-scroll
    >
        <p
            class={CLASS_ERROR_CODE}
            aria-hidden="true"
        >
            404
        </p>
        <h1
            id="error-not-found-title"
            class="mb-(--space-12) leading-[1.35] text-lead tracking-[-0.01em]"
        >
            <span class="sr-only">404: </span>
            Page not found.
        </h1>
        <a
            class={CLASS_BUTTON}
            href="/"
        >
            Return home
        </a>
    </div>
</section>
