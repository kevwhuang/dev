---
const CLASS_TOOL = 'stack__tool active:opacity-70 focus-visible:text-vermilion hover:text-vermilion flex flex-col items-center w-24 gap-2 text-slate-light duration-(--duration-fast) transition-[color,opacity]';

const STACK = [
    {
        label: 'Framework',
        tools: [
            { abbreviation: 'as', name: 'Astro', url: 'https://astro.build' },
            { abbreviation: 're', name: 'React', url: 'https://react.dev' },
            { abbreviation: 'tw', name: 'Tailwind', url: 'https://tailwindcss.com' },
        ],
    },
    {
        label: 'Language & runtime',
        tools: [
            { abbreviation: 'ts', name: 'TypeScript', url: 'https://www.typescriptlang.org' },
            { abbreviation: 'bn', name: 'Bun', url: 'https://bun.sh' },
        ],
    },
    {
        label: 'Services',
        tools: [
            { abbreviation: 'sb', name: 'Supabase', url: 'https://supabase.com' },
            { abbreviation: 'rs', name: 'Resend', url: 'https://resend.com' },
            { abbreviation: 'nf', name: 'Netlify', url: 'https://www.netlify.com' },
        ],
    },
    {
        label: 'Motion',
        tools: [
            { abbreviation: 'gs', name: 'GSAP', url: 'https://gsap.com' },
        ],
    },
    {
        label: 'Tooling',
        tools: [
            { abbreviation: 'cc', name: 'Claude Code', url: 'https://claude.com/claude-code' },
            { abbreviation: 'es', name: 'ESLint', url: 'https://eslint.org' },
            { abbreviation: 'vs', name: 'VS Code', url: 'https://code.visualstudio.com' },
        ],
    },
    {
        label: 'Testing',
        tools: [
            { abbreviation: 'vt', name: 'Vitest', url: 'https://vitest.dev' },
            { abbreviation: 'pw', name: 'Playwright', url: 'https://playwright.dev' },
        ],
    },
    {
        label: 'Source control',
        tools: [
            { abbreviation: 'gh', name: 'GitHub', url: 'https://github.com' },
        ],
    },
] as const;
---

<section
    class="stack section"
    aria-labelledby="stack-title"
>
    <div class="shell">
        <h2
            id="stack-title"
            class="mb-(--gap-l) pt-6 border-t border-graphite-light font-bold leading-[1.1] text-heading tracking-[-0.04em]"
            data-scroll
        >
            Stack
        </h2>
        <dl
            class="border-b border-graphite-light"
            data-scroll
            data-scroll-stagger="0.08"
        >
            {STACK.map(group => (
                <div class="stack__group grid gap-x-6 gap-y-4 pb-6 pt-5 border-t border-graphite-light">
                    <dt class="pt-2 font-mono text-xs tracking-[0.14em] uppercase wrap-anywhere text-slate-light">{group.label}</dt>
                    <dd>
                        <ul class="flex flex-wrap gap-3">
                            {group.tools.map(tool => (
                                <li>
                                    <a
                                        class={CLASS_TOOL}
                                        aria-label={`${tool.name} (opens in new tab)`}
                                        href={tool.url}
                                        target="_blank"
                                    >
                                        <span
                                            class="grid place-items-center size-14 border border-current font-mono text-sm tracking-[0.14em] uppercase select-none"
                                            aria-hidden="true"
                                        >
                                            {tool.abbreviation}
                                        </span>
                                        <span class="font-mono leading-[1.3] text-center text-xs tracking-[0.14em] uppercase wrap-anywhere">{tool.name}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .stack__group {
        grid-template-columns: 1fr 3fr;
    }

    @media (max-width: 768px) {
        .stack__group {
            grid-template-columns: 1fr;
        }
    }
</style>
