---
import IconAstro from '@components/icons/Astro.astro';
import IconBun from '@components/icons/Bun.astro';
import IconClaude from '@components/icons/Claude.astro';
import IconEslint from '@components/icons/Eslint.astro';
import IconGitHub from '@components/icons/GitHub.astro';
import IconGsap from '@components/icons/Gsap.astro';
import IconNetlify from '@components/icons/Netlify.astro';
import IconPlaywright from '@components/icons/Playwright.astro';
import IconReact from '@components/icons/React.astro';
import IconResend from '@components/icons/Resend.astro';
import IconSupabase from '@components/icons/Supabase.astro';
import IconTailwind from '@components/icons/Tailwind.astro';
import IconTypeScript from '@components/icons/TypeScript.astro';
import IconVitest from '@components/icons/Vitest.astro';
import IconVsCode from '@components/icons/VsCode.astro';

const CLASS_TOOL = 'stack__tool active:opacity-70 focus-visible:bg-graphite focus-visible:text-indigo-bright hover:-translate-y-0.5 hover:bg-graphite hover:text-indigo-bright flex flex-col items-center gap-4 px-4 py-6 bg-night-light text-silver duration-(--duration-fast) transition-[background-color,color,opacity,transform]';

const STACK = [
    {
        label: 'Foundation',
        tools: [
            { icon: IconBun, name: 'Bun', url: 'https://bun.sh' },
            { icon: IconTypeScript, name: 'TypeScript', url: 'https://www.typescriptlang.org' },
        ],
    },
    {
        label: 'Frameworks',
        tools: [
            { icon: IconAstro, name: 'Astro', url: 'https://astro.build' },
            { icon: IconReact, name: 'React', url: 'https://react.dev' },
            { icon: IconTailwind, name: 'Tailwind', url: 'https://tailwindcss.com' },
        ],
    },
    {
        label: 'Libraries',
        tools: [
            { icon: IconGsap, name: 'GSAP', url: 'https://gsap.com' },
            { icon: IconResend, name: 'Resend', url: 'https://resend.com' },
        ],
    },
    {
        label: 'Platforms',
        tools: [
            { icon: IconGitHub, name: 'GitHub', url: 'https://github.com' },
            { icon: IconNetlify, name: 'Netlify', url: 'https://www.netlify.com' },
            { icon: IconSupabase, name: 'Supabase', url: 'https://supabase.com' },
        ],
    },
    {
        label: 'Testing',
        tools: [
            { icon: IconPlaywright, name: 'Playwright', url: 'https://playwright.dev' },
            { icon: IconVitest, name: 'Vitest', url: 'https://vitest.dev' },
        ],
    },
    {
        label: 'Tooling',
        tools: [
            { icon: IconClaude, name: 'Claude Code', url: 'https://claude.com/product/claude-code' },
            { icon: IconEslint, name: 'ESLint', url: 'https://eslint.org' },
            { icon: IconVsCode, name: 'VS Code', url: 'https://code.visualstudio.com' },
        ],
    },
] as const;
---

<section
    class="stack section"
    aria-labelledby="stack-title"
>
    <div class="shell">
        <h2
            id="stack-title"
            class="sr-only"
        >
            Stack
        </h2>
        <dl
            class="grid gap-(--space-16)"
            data-scroll
            data-scroll-stagger="0.08"
        >
            {STACK.map(group => (
                <div class="stack__group grid items-center gap-x-6 gap-y-6">
                    <dt class="font-bold leading-[1.2] text-title tracking-[-0.04em] text-frost">{group.label}</dt>
                    <dd>
                        <ul class="stack__tools grid grid-cols-[repeat(auto-fill,minmax(136px,1fr))] gap-6">
                            {group.tools.map(({ icon: Icon, name, url }) => (
                                <li>
                                    <a
                                        class={CLASS_TOOL}
                                        aria-label={`${name} (opens in new tab)`}
                                        href={url}
                                        target="_blank"
                                    >
                                        <Icon />
                                        <span class="font-mono text-center text-xs tracking-[0.14em] break-words uppercase">{name}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .stack__group {
        grid-template-columns: 1fr 3fr;
    }

    @media (max-width: 768px) {
        .stack__group {
            grid-template-columns: 1fr;
        }

        .stack__tools {
            gap: 16px;
        }
    }
</style>
