---
const CLASS_NODE = 'pipeline__node grid place-items-center relative isolate size-12 border border-slate rounded-full font-mono text-sm bg-night text-slate-light duration-(--duration-base) transition-[background-color,border-color,color]';
const NUMBER_LENGTH = 2;
const STAGES = ['Scaffold', 'Design', 'Port', 'Iteration', 'Functionality', 'Content', 'Audit', 'Quality', 'Interactivity', 'Deployment'] as const;

const stages = STAGES.map((name, index) => ({ name, number: String(index + 1).padStart(NUMBER_LENGTH, '0') }));
---

<section
    class="pipeline section"
    aria-labelledby="pipeline-title"
>
    <div class="shell">
        <h1
            id="pipeline-title"
            class="sr-only"
        >
            Pipeline
        </h1>
        <div
            class="pipeline__flow relative"
            data-scroll
        >
            <div
                class="pipeline__rail absolute inset-x-[5%] overflow-hidden top-4 h-4 pointer-events-none"
                aria-hidden="true"
            >
                <div class="pipeline__track absolute inset-x-0 top-2 h-px bg-graphite-light" />
                <div class="pipeline__progress absolute inset-x-0 top-2 h-px bg-indigo origin-left" />
                <span class="pipeline__pulse absolute left-0 top-0 size-full duration-(--duration-base) opacity-0 transition-opacity" />
            </div>
            <ol class="pipeline__steps grid grid-cols-10">
                {stages.map((stage, index) => (
                    <li
                        class="pipeline__step flex flex-col items-center gap-3 text-center"
                        style={`--pipeline-step-index: ${index}`}
                    >
                        <span
                            class={CLASS_NODE}
                            aria-hidden="true"
                        >
                            {stage.number}
                        </span>
                        <span class="pipeline__label font-mono text-xs tracking-[0.14em] uppercase text-slate-light duration-(--duration-base) transition-colors">{stage.name}</span>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>

<style>
    .pipeline__flow--complete .pipeline__pulse {
        animation: pipeline__pulse-travel 6s linear infinite;
        opacity: 1;
    }

    .pipeline__flow--complete .pipeline__step--lit .pipeline__node::after {
        animation: pipeline__node-ring 6s linear infinite;
        animation-delay: calc(var(--pipeline-step-index) * 6s / 9);
    }

    .pipeline__node::after {
        border: 1px solid var(--color-indigo);
        border-radius: 9999px;
        content: '';
        inset: 0;
        opacity: 0;
        position: absolute;
        z-index: -1;
    }

    .pipeline__node::before {
        background-color: var(--color-indigo);
        border-radius: 9999px;
        content: '';
        filter: blur(10px);
        inset: 0;
        opacity: 0;
        position: absolute;
        z-index: -1;
    }

    .pipeline__pulse::before {
        background-color: var(--color-indigo);
        border-radius: 9999px;
        content: '';
        filter: blur(2px);
        height: 8px;
        left: 0;
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
    }

    .pipeline__step--lit .pipeline__label {
        color: var(--color-frost);
    }

    .pipeline__step--lit .pipeline__node {
        background-color: var(--color-midnight);
        border-color: var(--color-indigo);
        color: var(--color-indigo-bright);
    }

    .pipeline__step--lit .pipeline__node::after {
        animation: pipeline__node-bloom var(--duration-slow) ease-out both;
    }

    .pipeline__step--lit .pipeline__node::before {
        animation: pipeline__node-glow var(--duration-slow) ease-out both;
    }

    @media (max-width: 1024px) {
        .pipeline__flow--complete .pipeline__pulse {
            animation-name: pipeline__pulse-drop;
        }

        .pipeline__progress,
        .pipeline__track {
            bottom: 0;
            height: auto;
            left: 8px;
            right: auto;
            top: 0;
            width: 1px;
        }

        .pipeline__progress {
            transform-origin: top;
        }

        .pipeline__pulse::before {
            left: 50%;
            top: 0;
        }

        .pipeline__rail {
            bottom: 24px;
            height: auto;
            left: 16px;
            right: auto;
            top: 24px;
            width: 16px;
        }

        .pipeline__step {
            flex-direction: row;
            gap: 16px;
            text-align: left;
        }

        .pipeline__steps {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }
    }

    @media (max-width: 768px) {
        .pipeline__label {
            background-color: var(--color-night);
            padding-inline: 8px;
            position: relative;
        }

        .pipeline__rail {
            left: 0;
            margin-inline: auto;
            right: 0;
        }

        .pipeline__step {
            align-items: center;
            flex-direction: column;
            gap: 12px;
            text-align: center;
        }
    }

    @keyframes pipeline__node-bloom {
        from {
            opacity: 0.5;
            transform: scale(1);
        }

        to {
            opacity: 0;
            transform: scale(1.9);
        }
    }

    @keyframes pipeline__node-glow {
        from {
            opacity: 0;
        }

        30% {
            opacity: 0.35;
        }

        to {
            opacity: 0;
        }
    }

    @keyframes pipeline__node-ring {
        from {
            opacity: 0.5;
            transform: scale(1);
        }

        10% {
            opacity: 0;
            transform: scale(1.5);
        }

        to {
            opacity: 0;
            transform: scale(1.5);
        }
    }

    @keyframes pipeline__pulse-drop {
        from {
            transform: translateY(0);
        }

        to {
            transform: translateY(100%);
        }
    }

    @keyframes pipeline__pulse-travel {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(100%);
        }
    }
</style>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    import { REDUCED_MOTION_QUERY } from '@lib/constants';

    const COMPLETE_CLASS = 'pipeline__flow--complete';
    const FLOW_SELECTOR = '.pipeline__flow';
    const LABEL_DURATION = 0.5;
    const LABEL_EASE = 'power2.out';
    const LABEL_OFFSET = 8;
    const LABEL_SELECTOR = '.pipeline__label';
    const LIT_CLASS = 'pipeline__step--lit';
    const NODE_DURATION = 0.5;
    const NODE_EASE = 'back.out(1.6)';
    const NODE_SCALE = 0.6;
    const NODE_SELECTOR = '.pipeline__node';
    const NODE_STAGGER = 0.12;
    const NODE_START = 0.1;
    const PROGRESS_DURATION = 1.4;
    const PROGRESS_EASE = 'power2.inOut';
    const PROGRESS_SELECTOR = '.pipeline__progress';
    const PULSE_SELECTOR = '.pipeline__pulse';
    const RAIL_SELECTOR = '.pipeline__rail';
    const STEP_SELECTOR = '.pipeline__step';
    const TRIGGER_START = 'top 85%';
    const VERTICAL_QUERY = '(max-width: 1024px)';

    let timeline: gsap.core.Timeline | null = null;

    function initPipeline() {
        teardownPipeline();

        const flow = document.querySelector<HTMLElement>(FLOW_SELECTOR);

        if (!flow) return;

        const labels = flow.querySelectorAll<HTMLElement>(LABEL_SELECTOR);
        const nodes = flow.querySelectorAll<HTMLElement>(NODE_SELECTOR);
        const progress = flow.querySelector<HTMLElement>(PROGRESS_SELECTOR);
        const pulse = flow.querySelector<HTMLElement>(PULSE_SELECTOR);
        const rail = flow.querySelector<HTMLElement>(RAIL_SELECTOR);
        const steps = flow.querySelectorAll<HTMLElement>(STEP_SELECTOR);

        if (!progress || !pulse || !rail) return;

        if (window.matchMedia(REDUCED_MOTION_QUERY).matches) {
            flow.classList.add(COMPLETE_CLASS);
            gsap.set(labels, { opacity: 1, y: 0 });
            gsap.set(nodes, { opacity: 1, scale: 1 });
            gsap.set(progress, { scaleX: 1, scaleY: 1 });
            gsap.set(pulse, { x: 0, y: 0 });
            steps.forEach(step => step.classList.add(LIT_CLASS));

            return;
        }

        const isVertical = window.matchMedia(VERTICAL_QUERY).matches;

        gsap.set(labels, { opacity: 0, y: LABEL_OFFSET });
        gsap.set(nodes, { opacity: 0, scale: NODE_SCALE });
        gsap.set(progress, isVertical ? { scaleX: 1, scaleY: 0 } : { scaleX: 0, scaleY: 1 });
        gsap.set(pulse, { opacity: 0, x: 0, y: 0 });

        const flowTimeline = gsap.timeline({
            onComplete: () => {
                flow.classList.add(COMPLETE_CLASS);
                gsap.set(pulse, { x: 0, y: 0 });
            },
            scrollTrigger: {
                once: true,
                start: TRIGGER_START,
                trigger: flow,
            },
        });

        flowTimeline.set(pulse, { opacity: 1 }, 0);

        flowTimeline.to(progress, {
            duration: PROGRESS_DURATION,
            ease: PROGRESS_EASE,
            scaleX: 1,
            scaleY: 1,
        }, 0);

        flowTimeline.to(pulse, {
            duration: PROGRESS_DURATION,
            ease: PROGRESS_EASE,
            x: () => (isVertical ? 0 : rail.offsetWidth),
            y: () => (isVertical ? rail.offsetHeight : 0),
        }, 0);

        flowTimeline.to(nodes, {
            duration: NODE_DURATION,
            ease: NODE_EASE,
            opacity: 1,
            scale: 1,
            stagger: NODE_STAGGER,
        }, NODE_START);

        flowTimeline.to(labels, {
            duration: LABEL_DURATION,
            ease: LABEL_EASE,
            opacity: 1,
            stagger: NODE_STAGGER,
            y: 0,
        }, NODE_START);

        steps.forEach((step, index) => {
            flowTimeline.call(() => step.classList.add(LIT_CLASS), undefined, NODE_START + index * NODE_STAGGER);
        });

        timeline = flowTimeline;
    }

    function teardownPipeline() {
        timeline?.scrollTrigger?.kill();
        timeline?.kill();
        timeline = null;
    }

    document.addEventListener('astro:before-swap', teardownPipeline);
    document.addEventListener('astro:page-load', initPipeline);
    gsap.registerPlugin(ScrollTrigger);
</script>
