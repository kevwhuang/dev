---
import IconLogo from '@components/icons/Logo.astro';
import { ROUTES } from '@lib/constants';

const CLASS_LINK = 'navbar__link active:opacity-70 focus-visible:text-frost hover:text-frost inline-flex items-center relative h-12 px-3 font-mono text-xs tracking-[0.14em] uppercase text-silver duration-(--duration-fast) transition-[color,opacity]';

const navLinks = ROUTES.map(route => ({ ...route, isActive: Astro.url.pathname === route.href }));
---

<header class="navbar fixed top-0 z-100 h-(--header-height) w-full border-b border-graphite-light bg-night">
    <nav
        class="shell flex items-center justify-between h-full gap-6"
        aria-label="Main"
    >
        <a
            class="navbar__logo active:opacity-70 focus-visible:text-indigo-bright hover:text-indigo-bright inline-flex items-center relative text-indigo duration-(--duration-fast) transition-[color,opacity]"
            aria-label="Dev, home"
            href="/"
        >
            <IconLogo />
        </a>
        <ul class="flex items-center gap-[clamp(16px,calc(10.6667px+1.6667vw),32px)]">
            {navLinks.map(link => (
                <li>
                    <a
                        class:list={[CLASS_LINK, link.isActive && 'navbar__link--active']}
                        aria-current={link.isActive ? 'page' : undefined}
                        href={link.href}
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
    .navbar__link--active {
        color: var(--color-frost);
    }

    .navbar__link--active:focus-visible,
    .navbar__link--active:hover {
        color: var(--color-indigo-bright);
    }

    .navbar__link--active::after {
        background: var(--color-indigo);
        bottom: 12px;
        content: '';
        height: 1px;
        inset-inline: 0;
        position: absolute;
    }

    .navbar__logo::after {
        content: '';
        inset: -12px;
        position: absolute;
    }
</style>
