---
import { ROUTES } from '@lib/constants';

const CLASS_LINK = 'navbar__link active:opacity-70 focus-visible:text-frost hover:text-frost inline-flex items-center relative h-12 font-mono text-xs tracking-[0.14em] uppercase text-silver duration-(--duration-fast) transition-[color,opacity]';
const CLASS_LOGO = 'navbar__logo active:opacity-70 focus-visible:text-vermilion hover:text-vermilion inline-flex items-center relative font-bold leading-none text-2xl tracking-[-0.06em] text-frost duration-(--duration-fast) transition-[color,opacity]';

const navLinks = ROUTES.map(route => ({ ...route, isActive: Astro.url.pathname === route.href }));
---

<header class="navbar fixed top-0 z-100 h-(--header-height) w-full border-b border-graphite-light bg-night">
    <nav
        class="shell flex items-center justify-between h-full gap-6"
        aria-label="Main"
    >
        <a
            class={CLASS_LOGO}
            aria-label="Kevin Huang &mdash; Web Engineering, home"
            href="/"
        >
            WE
        </a>
        <ul class="flex items-center gap-(--gap-m)">
            {navLinks.map(link => (
                <li>
                    <a
                        class:list={[CLASS_LINK, link.isActive && 'navbar__link--active']}
                        aria-current={link.isActive ? 'page' : undefined}
                        href={link.href}
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
    .navbar__link::before {
        content: '';
        inset: 0 -8px;
        position: absolute;
    }

    .navbar__link--active {
        color: var(--color-frost);
    }

    .navbar__link--active:hover {
        color: var(--color-vermilion);
    }

    .navbar__link--active::after {
        background: var(--color-vermilion);
        bottom: 12px;
        content: '';
        height: 1px;
        inset-inline: 0;
        position: absolute;
    }

    .navbar__logo::after {
        content: '';
        inset: -12px;
        position: absolute;
    }
</style>
