---
import { getCollection } from 'astro:content';

import IconMenu from '@components/icons/Menu.astro';
import { TIERS } from '@lib/constants';

const CLASS_LINK = 'directory__link active:opacity-70 focus-visible:text-indigo-bright hover:text-indigo-bright block relative pl-3 py-1 text-sm wrap-anywhere text-silver duration-(--duration-fast) transition-[color,opacity]';
const CLASS_TOGGLE = 'directory__toggle active:bg-indigo-10 focus-visible:border-indigo focus-visible:text-indigo-bright hover:border-indigo hover:text-indigo-bright grid place-items-center size-(--directory-toggle) border-2 border-slate bg-night text-frost duration-(--duration-fast) transition-[background-color,border-color,color] select-none';

const projects = await getCollection('projects');

const tiers = TIERS.map(tier => ({
    ...tier,
    projects: projects
        .filter(project => project.data.tier === tier.id)
        .sort((first, second) => first.data.name.localeCompare(second.data.name)),
}));
---

<section
    class="directory bottom-(--shell-pad) fixed right-(--shell-pad) z-200"
    aria-label="Site index"
>
    <details class="directory__panel">
        <summary class={CLASS_TOGGLE}>
            <IconMenu />
            <span class="sr-only">Index</span>
        </summary>
        <nav
            class="directory__nav absolute bottom-full right-0 w-72 mb-(--directory-gap) p-3 border-2 border-slate bg-night-light"
            aria-label="Projects"
        >
            <ul class="directory__list grid grid-cols-2 gap-x-4 gap-y-3">
                {tiers.map(tier => (
                    <li>
                        <p class="mb-1 font-mono text-xs tracking-[0.14em] uppercase text-slate-light">{tier.label}</p>
                        <ul class="flex flex-col gap-1">
                            {tier.projects.map(project => (
                                <li>
                                    <a
                                        class={CLASS_LINK}
                                        href={`#${project.id}`}
                                    >
                                        {project.data.name}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </li>
                ))}
            </ul>
        </nav>
    </details>
</section>

<style>
    .directory {
        --directory-gap: 12px;
        --directory-toggle: 48px;
    }

    .directory--hidden {
        display: none;
    }

    .directory--wide .directory__list {
        grid-template-columns: 1fr;
        row-gap: 24px;
    }

    .directory--wide .directory__nav {
        background: none;
        border: none;
        bottom: auto;
        left: calc(50% + var(--width-shell) / 2 + 32px);
        margin: 0;
        padding: 0;
        position: fixed;
        right: auto;
        top: 50%;
        transform: translateY(-50%);
        width: 176px;
    }

    .directory--wide .directory__toggle {
        display: none;
    }

    .directory__link--current {
        color: var(--color-frost);
    }

    .directory__link--current:focus-visible,
    .directory__link--current:hover {
        color: var(--color-indigo-bright);
    }

    .directory__link--current::before {
        background: var(--color-indigo);
        content: '';
        inset-block: 0;
        left: 0;
        position: absolute;
        width: 2px;
    }

    .directory__toggle {
        list-style: none;
    }

    .directory__toggle::-webkit-details-marker {
        display: none;
    }

    @media (max-width: 1024px) {
        .directory__nav {
            max-height: calc(100dvh - var(--header-height) - var(--shell-pad) * 2 - var(--directory-toggle) - var(--directory-gap));
            overflow-y: auto;
            overscroll-behavior: contain;
        }
    }

    @media (max-width: 768px) {
        .directory__link {
            padding-block: 2px;
        }

        .directory__list {
            grid-template-columns: 1fr;
            row-gap: 8px;
        }

        .directory__list ul {
            gap: 0;
        }

        .directory__nav {
            bottom: calc(var(--shell-pad) + var(--directory-toggle) + var(--directory-gap));
            left: var(--shell-pad);
            margin: 0;
            position: fixed;
            right: var(--shell-pad);
            width: auto;
        }
    }
</style>

<script>
    const CURRENT_CLASS = 'directory__link--current';
    const FOOTER_SELECTOR = '.footer';
    const HIDDEN_CLASS = 'directory--hidden';
    const LINK_SELECTOR = '.directory__link';
    const PANEL_SELECTOR = '.directory__panel';
    const SECTION_SELECTOR = '.directory';
    const SPY_MARGIN = '-30% 0px -65% 0px';
    const STANZA_SELECTOR = '.tiers__stanza';
    const TOGGLE_SELECTOR = '.directory__toggle';
    const WIDE_CLASS = 'directory--wide';
    const WIDE_WIDTH = 1_728;

    const visibleIds = new Set<string>();

    let stanzaIds: string[] = [];
    let controller: AbortController | undefined;
    let footerObserver: IntersectionObserver | undefined;
    let isWide = false;
    let panelElement: HTMLDetailsElement | null = null;
    let sectionElement: HTMLElement | null = null;
    let spyObserver: IntersectionObserver | undefined;
    let toggleElement: HTMLElement | null = null;

    function closeDirectory() {
        if (isWide || !panelElement?.open) return;

        panelElement.open = false;
        toggleElement?.focus();
    }

    function handleFooterIntersect(entries: IntersectionObserverEntry[]) {
        const isFooterVisible = entries.some(entry => entry.isIntersecting);

        sectionElement?.classList.toggle(HIDDEN_CLASS, isFooterVisible);
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key === 'Escape') closeDirectory();
    }

    function handleLinkClick(event: MouseEvent) {
        const { currentTarget } = event;

        if (!(currentTarget instanceof HTMLAnchorElement)) return;

        const target = document.getElementById(currentTarget.hash.slice(1));

        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({ block: 'start' });
        history.replaceState(null, '', currentTarget.hash);
        closeDirectory();
    }

    function handleResize() {
        const nextIsWide = window.innerWidth >= WIDE_WIDTH;

        if (nextIsWide === isWide) return;

        isWide = nextIsWide;

        sectionElement?.classList.toggle(WIDE_CLASS, isWide);

        if (panelElement) panelElement.open = isWide;
    }

    function handleSpyIntersect(entries: IntersectionObserverEntry[]) {
        entries.forEach((entry) => {
            if (entry.isIntersecting) visibleIds.add(entry.target.id);
            else visibleIds.delete(entry.target.id);
        });

        const currentId = stanzaIds.find(stanzaId => visibleIds.has(stanzaId));

        if (currentId) setCurrentLink(currentId);
    }

    function initDirectory() {
        teardownDirectory();
        panelElement = document.querySelector<HTMLDetailsElement>(PANEL_SELECTOR);
        sectionElement = document.querySelector<HTMLElement>(SECTION_SELECTOR);
        toggleElement = document.querySelector<HTMLElement>(TOGGLE_SELECTOR);

        if (!panelElement || !sectionElement || !toggleElement) return;

        const footerElement = document.querySelector<HTMLElement>(FOOTER_SELECTOR);
        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(LINK_SELECTOR));
        const stanzas = Array.from(document.querySelectorAll<HTMLElement>(STANZA_SELECTOR));

        controller = new AbortController();
        footerObserver = new IntersectionObserver(handleFooterIntersect);
        spyObserver = new IntersectionObserver(handleSpyIntersect, { rootMargin: SPY_MARGIN });
        stanzaIds = stanzas.map(stanza => stanza.id);

        const { signal } = controller;

        stanzas.forEach(stanza => spyObserver?.observe(stanza));
        handleResize();
        links.forEach(link => link.addEventListener('click', handleLinkClick, { signal }));
        panelElement.addEventListener('keydown', handleKeydown, { signal });
        window.addEventListener('resize', handleResize, { signal });

        if (footerElement) footerObserver.observe(footerElement);
    }

    function setCurrentLink(currentId: string) {
        document.querySelectorAll<HTMLAnchorElement>(LINK_SELECTOR).forEach((link) => {
            const isCurrent = link.hash === `#${currentId}`;

            link.classList.toggle(CURRENT_CLASS, isCurrent);

            if (isCurrent) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
        });
    }

    function teardownDirectory() {
        controller?.abort();
        footerObserver?.disconnect();
        spyObserver?.disconnect();
        visibleIds.clear();
        controller = undefined;
        footerObserver = undefined;
        isWide = false;
        panelElement = null;
        sectionElement = null;
        spyObserver = undefined;
        stanzaIds = [];
        toggleElement = null;
    }

    document.addEventListener('astro:before-swap', teardownDirectory);
    document.addEventListener('astro:page-load', initDirectory);
</script>
