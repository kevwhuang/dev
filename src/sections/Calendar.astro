---
import { getCollection } from 'astro:content';

import { TIMEZONE } from '@lib/constants';

interface Cell {
    day: number;
    ghost: boolean;
    key: string;
    label: string;
    place: string;
    state: keyof typeof STATE_CLASSES;
}

const CALENDAR_YEARS = [2_026, 2_027] as const;
const CLASS_MONTH_BUTTON = 'calendar__button disabled:opacity-40 enabled:active:bg-indigo-10 enabled:hover:border-indigo enabled:hover:text-indigo-bright focus-visible:border-indigo focus-visible:text-indigo-bright grid place-items-center size-12 border border-slate font-mono text-base text-frost duration-(--duration-fast) transition-[background-color,border-color,color,opacity] select-none';
const CLASS_PLACE = 'calendar__place absolute bottom-3 left-3 z-1 max-w-[calc(100%-24px)] font-mono text-xs tracking-[0.14em] truncate uppercase text-indigo-bright';
const CLASS_TRAVELING = 'bg-indigo-10';
const DATE_PAD = 2;
const DAYS_PER_WEEK = 7;
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'] as const;
const SATURDAY = 6;

const STATE_CLASSES = {
    booked: 'text-slate-light',
    open: 'text-frost',
    past: 'text-slate-light',
    traveling: `${CLASS_TRAVELING} text-frost`,
    weekend: 'text-slate-light',
} as const;

const SUNDAY = 0;
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] as const;

const ranges = await getCollection('calendar');

const today = new Intl.DateTimeFormat('en-CA', { timeZone: TIMEZONE }).format(new Date());

const bookedRanges = ranges.filter(range => range.data.kind === 'booked');
const [todayYear, todayMonth] = today.split('-');
const travelRanges = ranges.filter(range => range.data.kind === 'travel');

const months = CALENDAR_YEARS.flatMap(year => MONTHS.map((name, index) => ({
    cells: getCells(year, index),
    id: `${year}-${String(index + 1).padStart(DATE_PAD, '0')}`,
    label: `${name} ${year}`,
})));

const initialMonth = Math.max(0, months.findIndex(month => month.id === `${todayYear}-${todayMonth}`));

function getCells(year: number, month: number) {
    const cells: Cell[] = [];
    const dayCount = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
    const firstWeekday = new Date(Date.UTC(year, month, 1)).getUTCDay();
    const labeled = new Set<string>();

    for (let offset = firstWeekday; offset > 0; offset--) {
        cells.push(getGhostCell(year, month, 1 - offset, labeled));
    }

    for (let day = 1; day <= dayCount; day++) {
        const date = new Date(Date.UTC(year, month, day));

        const key = getKey(date);
        const weekday = date.getUTCDay();

        const range = getTravelRange(key);

        const place = getPlace(range, labeled);
        const state = getDayState(key, weekday, Boolean(range));

        const label = state === 'booked' || state === 'open' || state === 'traveling' ? state : '';

        cells.push({ day, ghost: false, key, label, place, state });
    }

    for (let day = dayCount + 1; cells.length % DAYS_PER_WEEK !== 0; day++) {
        cells.push(getGhostCell(year, month, day, labeled));
    }

    return cells;
}

function getDayState(key: string, weekday: number, isTraveling: boolean) {
    if (isTraveling) return 'traveling';
    if (key < today) return 'past';
    if (weekday === SATURDAY || weekday === SUNDAY) return 'weekend';
    if (bookedRanges.some(range => key >= range.data.start && key <= range.data.end)) return 'booked';

    return 'open';
}

function getGhostCell(year: number, month: number, day: number, labeled: Set<string>): Cell {
    const date = new Date(Date.UTC(year, month, day));

    const key = getKey(date);
    const weekday = date.getUTCDay();

    const range = getTravelRange(key);

    const place = getPlace(range, labeled);
    const state = getDayState(key, weekday, Boolean(range));

    return { day: date.getUTCDate(), ghost: true, key, label: '', place, state };
}

function getKey(date: Date) {
    return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(DATE_PAD, '0')}-${String(date.getUTCDate()).padStart(DATE_PAD, '0')}`;
}

function getPlace(range: ReturnType<typeof getTravelRange>, labeled: Set<string>) {
    if (!range || labeled.has(range.id)) return '';

    labeled.add(range.id);

    return range.data.place ?? '';
}

function getTravelRange(key: string) {
    return travelRanges.find(range => key >= range.data.start && key <= range.data.end);
}
---

<section
    class="calendar section"
    aria-labelledby="calendar-title"
>
    <div class="shell">
        <div
            class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 mb-(--space-12) pt-6 border-graphite-light border-t"
            data-scroll
        >
            <h2
                id="calendar-title"
                class="font-bold leading-[1.1] text-heading tracking-[-0.04em]"
                aria-live="polite"
            >
                <span class="sr-only">Calendar: </span>
                <span class="calendar__label">{months[initialMonth].label}</span>
            </h2>
            <div class="flex gap-2">
                <button
                    class={CLASS_MONTH_BUTTON}
                    aria-label="Previous month"
                    data-calendar-previous
                    disabled={initialMonth === 0}
                    type="button"
                >
                    &larr;
                </button>
                <button
                    class={CLASS_MONTH_BUTTON}
                    aria-label="Next month"
                    data-calendar-next
                    disabled={initialMonth === months.length - 1}
                    type="button"
                >
                    &rarr;
                </button>
            </div>
        </div>
        <div
            class="select-none"
            data-scroll
        >
            <ul
                class="grid grid-cols-7 pb-3 font-mono text-xs tracking-[0.14em] uppercase text-slate-light"
                aria-hidden="true"
            >
                {WEEKDAYS.map(weekday => <li class="pl-3">{weekday}</li>)}
            </ul>
            {months.map((month, index) => (
                <ul
                    class="calendar__grid grid grid-cols-7 overflow-hidden isolate border-graphite-light border-l border-t"
                    data-label={month.label}
                    hidden={index !== initialMonth}
                >
                    {month.cells.map(cell => (
                        <li
                            class:list={[
                                'calendar__day relative p-3 border-b border-graphite-light border-r',
                                cell.ghost ? ['calendar__day--ghost', cell.state === 'traveling' && CLASS_TRAVELING, 'text-slate'] : STATE_CLASSES[cell.state],
                            ]}
                            aria-hidden={cell.ghost ? 'true' : undefined}
                        >
                            <time
                                class="font-mono text-base"
                                datetime={cell.key}
                            >
                                {cell.day}
                            </time>
                            {cell.label && <span class="sr-only">{cell.label}</span>}
                            {cell.place && <span class={CLASS_PLACE}>{cell.place}</span>}
                        </li>
                    ))}
                </ul>
            ))}
        </div>
    </div>
</section>

<style>
    .calendar__day {
        min-height: clamp(72px, calc(40px + 5vw), 104px);
    }

    @media (max-width: 768px) {
        .calendar__place {
            max-width: none;
            overflow: visible;
        }

        .calendar__day:nth-child(7n - 1) .calendar__place,
        .calendar__day:nth-child(7n) .calendar__place {
            left: auto;
            right: 12px;
        }
    }
</style>

<script>
    let controller: AbortController | null = null;
    let grids: HTMLElement[] = [];
    let monthIndex = 0;
    let monthLabel: HTMLElement | null = null;
    let nextButton: HTMLButtonElement | null = null;
    let previousButton: HTMLButtonElement | null = null;

    function initCalendar() {
        controller?.abort();
        controller = new AbortController();
        grids = Array.from(document.querySelectorAll<HTMLElement>('.calendar__grid'));
        monthLabel = document.querySelector<HTMLElement>('.calendar__label');
        nextButton = document.querySelector<HTMLButtonElement>('[data-calendar-next]');
        previousButton = document.querySelector<HTMLButtonElement>('[data-calendar-previous]');

        if (!grids.length || !monthLabel || !nextButton || !previousButton) return;

        const { signal } = controller;

        monthIndex = Math.max(0, grids.findIndex(grid => !grid.hidden));
        nextButton.addEventListener('click', () => showMonth(monthIndex + 1), { signal });
        previousButton.addEventListener('click', () => showMonth(monthIndex - 1), { signal });
    }

    function showMonth(index: number) {
        if (!monthLabel || !nextButton || !previousButton) return;
        if (index < 0 || index >= grids.length) return;

        monthIndex = index;
        monthLabel.textContent = grids[index].dataset.label ?? '';
        nextButton.disabled = index === grids.length - 1;
        previousButton.disabled = index === 0;

        if (document.activeElement === nextButton && nextButton.disabled) previousButton.focus();
        if (document.activeElement === previousButton && previousButton.disabled) nextButton.focus();

        grids.forEach((grid, gridIndex) => {
            grid.hidden = gridIndex !== index;
        });
    }

    document.addEventListener('astro:page-load', initCalendar);
</script>
